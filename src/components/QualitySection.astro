---
import { restaurant } from '@/data/restaurant.config';

const icons = ['⏱', '🍅', '🧀', '🔥'];
---

<section class="bg-charcoal-900 py-12 text-cream-50 sm:py-20">
  <div class="container-page">
    <div class="max-w-xl">
      <p class="eyebrow text-tomato-400">Unsere Qualität</p>
      <h2 class="section-heading mt-3 text-cream-50">Nur wenige Zutaten. Aber die richtigen.</h2>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl2 bg-white/10 sm:mt-12 sm:grid-cols-2 lg:grid-cols-4">
      {restaurant.story.highlights.map((h, i) => (
        <div class="flex flex-col gap-1.5 bg-charcoal-900 p-4 transition-colors hover:bg-white/[0.03] sm:gap-3 sm:p-8">
          <span class="text-2xl sm:text-3xl">{icons[i % icons.length]}</span>
          <h3 class="font-display text-sm font-semibold sm:text-lg">{h.label}</h3>
          <p class="hidden text-sm text-cream-50/60 sm:block">{h.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
