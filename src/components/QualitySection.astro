---
import { restaurant } from '@/data/restaurant.config';

const icons = ['⏱', '🍅', '🧀', '🔥'];
---

<section class="bg-charcoal-900 py-20 text-cream-50">
  <div class="container-page">
    <div class="max-w-xl">
      <p class="eyebrow text-tomato-400">Unsere Qualität</p>
      <h2 class="section-heading mt-3 text-cream-50">Nur wenige Zutaten. Aber die richtigen.</h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-xl2 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {restaurant.story.highlights.map((h, i) => (
        <div class="flex flex-col gap-3 bg-charcoal-900 p-8 transition-colors hover:bg-white/[0.03]">
          <span class="text-3xl">{icons[i % icons.length]}</span>
          <h3 class="font-display text-lg font-semibold">{h.label}</h3>
          <p class="text-sm text-cream-50/60">{h.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
