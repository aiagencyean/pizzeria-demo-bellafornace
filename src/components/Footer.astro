---
import { restaurant } from '@/data/restaurant.config';

const year = new Date().getFullYear();
---

<footer class="border-t border-charcoal-900/10 bg-charcoal-900 text-cream-50">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-tomato-500">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none">
            <path d="M12 3 L21 19 A11 11 0 0 1 3 19 Z" fill="white" />
          </svg>
        </span>
        <span class="font-display text-lg font-semibold">{restaurant.name}</span>
      </a>
      <p class="mt-4 max-w-xs text-sm text-cream-50/60">
        Handgemachte Pizza und Pasta nach original italienischer Tradition — frisch, ehrlich, mit Liebe gebacken.
      </p>
      <div class="mt-5 flex gap-3">
        <a
          href={restaurant.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
            <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 2.1.26 2.6.45.6.24 1.1.55 1.6 1.05.5.5.8 1 1.05 1.6.2.5.4 1.4.45 2.6.07 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.26 2.1-.45 2.6-.24.6-.55 1.1-1.05 1.6-.5.5-1 .8-1.6 1.05-.5.2-1.4.4-2.6.45-1.3.07-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-2.1-.26-2.6-.45a4.3 4.3 0 0 1-1.6-1.05 4.3 4.3 0 0 1-1.05-1.6c-.2-.5-.4-1.4-.45-2.6C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.26-2.1.45-2.6.24-.6.55-1.1 1.05-1.6.5-.5 1-.8 1.6-1.05.5-.2 1.4-.4 2.6-.45C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.52 0-4.76.07-1 .05-1.5.2-1.86.34-.47.18-.8.4-1.15.75-.35.35-.57.68-.75 1.15-.14.36-.3.87-.34 1.86C3.07 8.5 3.07 8.85 3.07 12s0 3.5.07 4.76c.05 1 .2 1.5.34 1.86.18.47.4.8.75 1.15.35.35.68.57 1.15.75.36.14.87.3 1.86.34 1.24.06 1.6.07 4.76.07s3.52 0 4.76-.07c1-.05 1.5-.2 1.86-.34.47-.18.8-.4 1.15-.75.35-.35.57-.68.75-1.15.14-.36.3-.87.34-1.86.06-1.25.07-1.6.07-4.76s0-3.5-.07-4.76c-.05-1-.2-1.5-.34-1.86a3 3 0 0 0-.75-1.15 3 3 0 0 0-1.15-.75c-.36-.14-.87-.3-1.86-.34C15.5 3.07 15.15 3.07 12 3.07Zm0 3.4a5.53 5.53 0 1 1 0 11.06 5.53 5.53 0 0 1 0-11.06Zm0 1.8a3.72 3.72 0 1 0 0 7.44 3.72 3.72 0 0 0 0-7.44Zm5.75-1.98a1.3 1.3 0 1 1-2.6 0 1.3 1.3 0 0 1 2.6 0Z"/>
          </svg>
        </a>
        <a
          href={restaurant.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
            <path d="M13.5 21v-8.1h2.7l.4-3.2h-3.1V7.6c0-.9.3-1.5 1.6-1.5h1.7V3.1C16.5 3 15.4 3 14.2 3c-2.5 0-4.3 1.5-4.3 4.4v2.3H7.2v3.2h2.7V21h3.6Z"/>
          </svg>
        </a>
      </div>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-cream-50/50">Kontakt</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-cream-50/80">
        <li>{restaurant.address.street}</li>
        <li>{restaurant.address.postalCode} {restaurant.address.city}</li>
        <li><a href={`tel:${restaurant.phone}`} class="hover:text-tomato-400">{restaurant.phoneDisplay}</a></li>
        <li><a href={`mailto:${restaurant.email}`} class="hover:text-tomato-400">{restaurant.email}</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-cream-50/50">Öffnungszeiten</h3>
      <ul class="mt-4 space-y-2 text-sm text-cream-50/80">
        {restaurant.hours.map((h) => (
          <li class="flex justify-between gap-4">
            <span>{h.day}</span>
            <span>{h.open} – {h.close}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wide text-cream-50/50">Navigation</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-cream-50/80">
        <li><a href="/menu" class="hover:text-tomato-400">Speisekarte</a></li>
        <li><a href="/#about" class="hover:text-tomato-400">Über uns</a></li>
        <li><a href="/#standort" class="hover:text-tomato-400">Standort</a></li>
        <li><a href="/dashboard" class="hover:text-tomato-400">Restaurant-Dashboard</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col items-center justify-between gap-3 py-5 text-xs text-cream-50/50 sm:flex-row">
      <p>© {year} {restaurant.name}. Alle Rechte vorbehalten.</p>
      <div class="flex gap-5">
        <a href="/impressum" class="hover:text-cream-50">Impressum</a>
        <a href="/datenschutz" class="hover:text-cream-50">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
