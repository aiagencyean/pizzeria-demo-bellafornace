---
import { reviews } from '@/data/reviews';
import { restaurant } from '@/data/restaurant.config';

// NOTE: `reviews` are DEMO/placeholder content — see src/data/reviews.ts.
// Replace with real, permission-cleared customer reviews before launch.
---

<section class="bg-cream-50 py-12 sm:py-28">
  <div class="container-page">
    <div class="mx-auto max-w-xl text-center">
      <p class="eyebrow">Bewertungen</p>
      <h2 class="section-heading mt-3">Was unsere Gäste sagen</h2>
      <p class="mt-3 text-sm text-charcoal-900/50">Demo-Bewertungen · {restaurant.rating.value}/5 aus {restaurant.rating.count} Bewertungen</p>
    </div>

    <div class="mt-6 grid gap-3 sm:mt-12 sm:grid-cols-3 sm:gap-6">
      {reviews.map((review) => (
        <div class="card flex flex-col gap-3 p-5 sm:gap-4 sm:p-7">
          <div class="flex text-gold-500">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg viewBox="0 0 20 20" class={`h-4 w-4 fill-current ${i < review.rating ? '' : 'opacity-25'}`}>
                <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z"/>
              </svg>
            ))}
          </div>
          <p class="text-sm leading-relaxed text-charcoal-900/75">&ldquo;{review.text}&rdquo;</p>
          <p class="mt-auto text-sm font-semibold text-charcoal-900">{review.name}</p>
        </div>
      ))}
    </div>
  </div>
</section>
