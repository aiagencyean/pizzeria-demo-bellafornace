---
import Layout from '@/layouts/Layout.astro';
import DashboardApp from '@/components/react/DashboardApp';
import { restaurant } from '@/data/restaurant.config';
---

<Layout title={`Bestell-Dashboard — ${restaurant.name}`}>
  <section class="bg-cream-100 py-12 sm:py-16">
    <div class="container-page">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Restaurant-Dashboard</p>
          <h1 class="section-heading mt-2">Bestellungen</h1>
        </div>
        <p class="max-w-sm text-xs text-charcoal-900/50">
          Demo-Dashboard: Bestellungen werden lokal in diesem Browser gespeichert. In Produktion würde dies an eine
          echte Datenbank angebunden.
        </p>
      </div>
      <div class="mt-8">
        <DashboardApp client:only="react" />
      </div>
    </div>
  </section>
</Layout>
