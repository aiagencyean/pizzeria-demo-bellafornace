---
import Layout from '@/layouts/Layout.astro';
import CheckoutApp from '@/components/react/CheckoutApp';
import { restaurant } from '@/data/restaurant.config';
---

<Layout title={`Kasse — ${restaurant.name}`}>
  <section class="bg-cream-50 py-12 sm:py-16">
    <div class="container-page">
      <h1 class="section-heading">Kasse</h1>
      <div class="mt-8">
        <CheckoutApp client:only="react" />
      </div>
    </div>
  </section>
</Layout>
