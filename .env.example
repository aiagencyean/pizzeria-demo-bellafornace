# ── Order notification email ─────────────────────────────────────────────
# Copy this file to `.env` and fill in real values to enable live order
# emails to the restaurant. Until SMTP_HOST is set, the app runs in DEMO
# MODE: incoming orders are logged to the server console instead of being
# emailed, and the API response is flagged accordingly. See
# src/pages/api/orders.ts and src/lib/email.ts.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Address the "new order" email is sent FROM (often the same as SMTP_USER)
ORDER_EMAIL_FROM="Bella Fornace <orders@example.com>"

# Address(es) the restaurant reads orders at (comma-separated for multiple)
ORDER_EMAIL_TO="restaurant@example.com"
